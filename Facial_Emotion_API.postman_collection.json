    {
      "name": "Predict (Image)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Has all required fields\", () => {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"predicted_emotion\");\r",
              "    pm.expect(json).to.have.property(\"confidence\");\r",
              "    pm.expect(json).to.have.property(\"all_scores\");\r",
              "    pm.expect(json).to.have.property(\"inference_time_ms\");\r",
              "});\r",
              "\r",
              "pm.test(\"Confidence is between 0 and 1\", () => {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.confidence).to.be.within(0, 1);\r",
              "});\r",
              "\r",
              "pm.test(\"Emotion label is valid\", () => {\r",
              "    const json = pm.response.json();\r",
              "    const valid = [\"angry\",\"disgust\",\"fear\",\"happy\",\"neutral\",\"sad\",\"surprise\"];\r",
              "    pm.expect(valid).to.include(json.predicted_emotion);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
